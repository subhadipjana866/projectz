# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# JWT Configuration
SECRET_KEY=your_secret_key_here_change_this_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google OAuth Configuration (for YouTube integration)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Public URL of this server (single-server deploy: frontend + API on one origin).
# Used to build the Google OAuth redirect_uri — must exactly match a redirect
# URI registered in Google Cloud Console, e.g. https://collabhub.example.com
APP_URL=http://localhost:8000

# Where post-login/OAuth redirects should land. Defaults to APP_URL, so you
# normally don't need to set this separately in a single-server deploy.
FRONTEND_URL=http://localhost:3000

# Port the server listens on
PORT=8000

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=your_aws_region_here
AWS_S3_BUCKET_NAME=your_bucket_name_here
